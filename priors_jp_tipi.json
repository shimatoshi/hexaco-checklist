  "key_findings": {
    "age_effects": {
      "Agreeableness": {
        "direction": "↑",
        "B": 0.022,
        "p": "<.001",
        "note": "linear age increase"
      },
      "Conscientiousness": {
        "direction": "↑",
        "B": 0.038,
        "p": "<.001",
        "note": "linear age increase, largest effect"
      },
      "Neuroticism": {
        "direction": "↓",
        "B": -0.011,
        "p": "<.01",
        "note": "linear age decrease"
      },
      "Extraversion": {
        "direction": "NS",
        "note": "no significant age effect overall"
      },
      "Openness": {
        "direction": "NS",
        "note": "no significant age effect overall"
      }
    },
    "sex_effects": {
